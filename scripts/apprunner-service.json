{
  "ServiceName": "marathi-nlp-studio",
  "SourceConfiguration": {
    "ImageRepository": {
      "ImageIdentifier": "236052539520.dkr.ecr.us-east-1.amazonaws.com/marathi-nlp-studio:latest",
      "ImageRepositoryType": "ECR",
      "ImageConfiguration": {
        "Port": "8000",
        "RuntimeEnvironmentVariables": {
          "QUANTIZE": "1",
          "TORCH_THREADS": "1",
          "MODEL_NAME": "l3cube-pune/marathi-ner",
          "MAX_LENGTH": "256",
          "CORS_ORIGINS": "https://marathi-nlp-studio.vercel.app"
        }
      }
    },
    "AutoDeploymentsEnabled": false,
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::236052539520:role/AppRunnerECRAccessRole"
    }
  },
  "InstanceConfiguration": {
    "Cpu": "1024",
    "Memory": "2048"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/health",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  }
}
