# Backend configuration (copy to .env and adjust as needed)

# Inference model. Default is the official MahaNER-fine-tuned model.
# To use a locally trained model instead, point this at the output dir:
#   MODEL_NAME=./models/marathi-ner
MODEL_NAME=l3cube-pune/marathi-ner

# Base model used by training/train.py when fine-tuning from scratch.
BASE_MODEL=l3cube-pune/marathi-bert-v2

MAX_LENGTH=256

# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum characters accepted by /predict.
MAX_TEXT_CHARS=5000

# Training hyperparameters (optional overrides)
EPOCHS=3
TRAIN_BATCH_SIZE=16
EVAL_BATCH_SIZE=32
LEARNING_RATE=3e-5
